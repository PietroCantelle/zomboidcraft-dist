		}
		{
			dependencies: [
				"5A3ADF3FD43853AE"
			]
			description: [
				"&8Onde: Território dos Corvos"
				""
				"&fMãe, tô com os Corvo. Não fica brava. O Dente não deixa ninguém mexer com a gente e dá comida todo dia. Eu tenho que ficar de vigia e fazer o sino. O sino é quando amarra alguém no poste pra zumbi ir lá e não vir pra cá. Eu não gosto do sino. Eu fecho o olho. Mãe, se a senhora tiver viva, eu tô na usina, pede pro Dente, fala que é mãe do Pena."
				""
				"&8&oO documento é um item: clique direito para ler. A tarefa se marca sozinha quando alguém do grupo lê."
			]
			hide_until_deps_complete: true
			icon: "minecraft:feather"
			id: "6FEB804256BBEFD1"
			optional: true
